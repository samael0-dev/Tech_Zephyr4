{
  "buildCommand": "cd frontend-1/citrix && npm install && npm run build",
  "outputDirectory": "frontend-1/citrix/dist",
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "https://tech-zephyr4.onrender.com/api/v1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://tech-zephyr4.onrender.com/api/v1/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
