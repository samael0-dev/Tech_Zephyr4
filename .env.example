# CIT Campus Operations Platform Environment Configuration
APP_NAME="CIT Campus Operations Platform"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# In production, generate a secure random 32+ byte string (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=cit-hackathon-super-secret-jwt-key-2027-change-in-prod-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite default for zero-setup development & tests)
DATABASE_URL=sqlite:///./campus_ops.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cit_campus_ops

# Dataset Paths
DATASET_PATH=CrunchWeek_StarterPack/data/cit_public.json
STARTER_PACK_DIR=CrunchWeek_StarterPack

# AI Engine / LLM Configuration
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
